{
  "name": "picture-dictionary",
  "productName": "قاموس مصوّر",
  "version": "1.0.0",
  "description": "قاموس مصوّر إنجليزي-عربي",
  "main": "app.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
